# ============================================================
# EMS AI Service – Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# -- MySQL Database (same DB as EMS backend) ------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=evaluator_mapping_db
DB_USERNAME=root
DB_PASSWORD=

# -- LLM Provider (openai | google | anthropic) ---------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-llm-api-key-here
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# -- EMS Spring Boot Backend -----------------------------------
EMS_API_BASE_URL=http://localhost:8080
EMS_API_JWT_TOKEN=your-ems-jwt-token-here
EMS_API_TIMEOUT=30

# -- MCP Server ------------------------------------------------
MCP_HOST=localhost
MCP_PORT=8002

# -- Workflow API ----------------------------------------------
API_HOST=0.0.0.0
API_PORT=8001

# -- Import directories ----------------------------------------
IMPORT_DATA_DIR=./data/imports
ATTACHMENT_STORAGE_DIR=./data/attachments

# -- Logging ---------------------------------------------------
LOG_LEVEL=INFO
